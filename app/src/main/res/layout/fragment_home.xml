<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/apatch_background"
    android:paddingHorizontal="16dp"
    android:paddingTop="20dp"
    android:paddingBottom="96dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Driver Loader"
            android:textColor="@color/apatch_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- APatch-style 2 Side-by-Side Status Cards (Borderless) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <!-- Card 1: Kernel Driver Card (Left) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/apatch_surface"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_nav_home_fill"
                        app:tint="@color/apatch_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Kernel Driver"
                        android:textColor="@color/apatch_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDriverState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Working"
                        android:textColor="@color/apatch_success"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvKernelVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Linux 4.19"
                        android:textColor="@color/apatch_text_secondary"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:singleLine="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: SuperUser / Root Card (Right) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/apatch_surface"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/info_circle_filled"
                        app:tint="@color/apatch_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="SuperUser"
                        android:textColor="@color/apatch_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSuperuserState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Granted"
                        android:textColor="@color/apatch_success"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNodesSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Node: /dev/BYNb"
                        android:textColor="@color/apatch_text_secondary"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:singleLine="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Driver Action Controls (Borderless APatch Style Buttons) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickLoadQx"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="QX"
                android:textColor="@color/apatch_on_primary"
                android:textStyle="bold"
                android:textSize="15sp"
                app:icon="@drawable/play_circle"
                app:iconTint="@color/apatch_on_primary"
                app:backgroundTint="@color/apatch_primary"
                app:cornerRadius="20dp"
                app:strokeWidth="0dp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickLoadRt"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="RT"
                android:textColor="@color/apatch_text_primary"
                android:textStyle="bold"
                android:textSize="15sp"
                app:icon="@drawable/device_mobile_down"
                app:iconTint="@color/apatch_text_primary"
                app:backgroundTint="@color/apatch_surface_variant"
                app:cornerRadius="20dp"
                app:strokeWidth="0dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickUnload"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="Stop Driver"
            android:textColor="@color/apatch_error"
            android:textStyle="bold"
            android:textSize="15sp"
            app:backgroundTint="@color/apatch_error_container"
            app:icon="@drawable/trash"
            app:iconTint="@color/apatch_error"
            app:cornerRadius="20dp"
            app:strokeWidth="0dp" />

        <!-- Console Header & Clear -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TERMINAL LOG"
                android:textColor="@color/apatch_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnHomeClearLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear"
                android:textColor="@color/apatch_primary"
                android:textSize="12sp"
                android:padding="6dp" />
        </LinearLayout>

        <!-- Live Terminal (Borderless) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="@color/apatch_terminal_bg"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ScrollView
                android:id="@+id/scrollHomeLog"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvHomeConsoleLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/apatch_success"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:text="NinMods Driver Initialized...\n" />
            </ScrollView>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
