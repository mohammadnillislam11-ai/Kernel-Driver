<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/apatch_background">

    <!-- Fragment Display Container -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- APatch Exact Floating Capsule Bottom Navigation Bar (Icon Buttons Only) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/floatingBar"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:background="@drawable/apatch_floating_bar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:elevation="12dp"
            android:paddingHorizontal="8dp">

            <!-- 1. Dashboard Tab (Home Icon) -->
            <FrameLayout
                android:id="@+id/tabDashboard"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/apatch_pill_selected"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconDashboard"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_home_fill"
                    app:tint="@color/apatch_primary" />
            </FrameLayout>

            <!-- 2. Driver Loader Tab (Wrench Icon) -->
            <FrameLayout
                android:id="@+id/tabLoader"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="4dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconLoader"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_wrench"
                    app:tint="#939AA5" />
            </FrameLayout>

            <!-- 3. Settings Tab (Gear Icon) -->
            <FrameLayout
                android:id="@+id/tabSettings"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="4dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconSettings"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_gear"
                    app:tint="#939AA5" />
            </FrameLayout>

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
