<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/apatch_background">

    <!-- Fragment Display Container -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="96dp" />

    <!-- APatch Exact Floating Capsule Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/floatingBar"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:background="@drawable/apatch_floating_bar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:elevation="12dp"
            android:paddingHorizontal="10dp">

            <!-- 1. Home / Dashboard Tab (Pill Expandable) -->
            <LinearLayout
                android:id="@+id/tabHome"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/apatch_pill_selected"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconHome"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_home_fill"
                    app:tint="#D0BCFF" />

                <TextView
                    android:id="@+id/textHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Home"
                    android:textColor="#E3E2E6"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="visible" />
            </LinearLayout>

            <!-- 2. Driver Loader Tab (Wrench Tool Icon Button) -->
            <LinearLayout
                android:id="@+id/tabDrivers"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconDrivers"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_wrench"
                    app:tint="#939AA5" />

                <TextView
                    android:id="@+id/textDrivers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Loader"
                    android:textColor="#E3E2E6"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 3. Tuning / Modules Tab (Slider Tuning Icon Button) -->
            <LinearLayout
                android:id="@+id/tabTuning"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconTuning"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_tuning"
                    app:tint="#939AA5" />

                <TextView
                    android:id="@+id/textTuning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Drivers"
                    android:textColor="#E3E2E6"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 4. Settings Tab (Gear Icon Button) -->
            <LinearLayout
                android:id="@+id/tabSettings"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconSettings"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_gear"
                    app:tint="#939AA5" />

                <TextView
                    android:id="@+id/textSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Settings"
                    android:textColor="#E3E2E6"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
