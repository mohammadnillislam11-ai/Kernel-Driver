<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/apatch_background"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- Logo -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="76dp"
        android:layout_height="76dp"
        app:cardCornerRadius="22dp"
        app:cardBackgroundColor="@color/apatch_surface_variant"
        app:strokeColor="@color/apatch_outline"
        app:strokeWidth="1dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:src="@drawable/logo_n" />
    </com.google.android.material.card.MaterialCardView>

    <!-- App Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="NinMods"
        android:textColor="@color/apatch_text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Access Key Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAccessKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:hint="Access Key"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxStrokeColor="@color/apatch_primary"
        app:hintTextColor="@color/apatch_primary"
        app:passwordToggleEnabled="true"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAccessKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="@color/apatch_text_primary"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Remember Checkbox -->
    <CheckBox
        android:id="@+id/cbRemember"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Remember session"
        android:textColor="@color/apatch_text_secondary"
        android:checked="true" />

    <!-- Login Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:text="Login"
        android:textColor="@color/apatch_on_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:backgroundTint="@color/apatch_primary" />

</LinearLayout>
