<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DriverLoader" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/apatch_background</item>
        <item name="android:navigationBarColor">@color/apatch_surface</item>
        <item name="android:windowBackground">@color/apatch_background</item>
        <item name="colorPrimary">@color/apatch_primary</item>
        <item name="colorSecondary">@color/apatch_secondary</item>
        <item name="colorSurface">@color/apatch_surface</item>
        <item name="colorOutline">@color/apatch_outline</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

    <style name="Theme.APatch" parent="Theme.DriverLoader">
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

    <style name="Theme.APatch.WebUI" parent="Theme.DriverLoader">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

</resources>
